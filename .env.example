KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
SEPOLIA_RPC_URL=
# The KeeperHub Turnkey EOA granted `flowOperator` permissions on the
# treasury (see docs/superpowers/specs/2026-09-06-runway-design.md). Only
# needed for a real (non-dry-run) `src/cli.ts` run: it is the `account` a
# local simulateContract call impersonates before anything is broadcast.
KEEPERHUB_FLOW_OPERATOR_ADDRESS=

# Only for the scheduled trigger (`pnpm serve`, see docs/SCHEDULING.md).
# The shared secret a caller must send in the `x-runway-token` header. At
# least 32 characters -- the server refuses to start below that, so an unset
# or half-configured variable fails closed instead of authenticating
# everyone. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
RUNWAY_TRIGGER_TOKEN=
# Which policy the scheduled tick runs. Deliberately an environment variable
# and never a request field: a caller-supplied path would let anyone holding
# the token point the keeper at a different treasury.
RUNWAY_POLICY=policies/treasury.sepolia.yaml
# Port to listen on. Hosting platforms set this themselves.
PORT=8080
